# --- Required to run the app ---
PUBLIC_SUPABASE_URL=your-project-url-here
PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# Email of the account that should see the admin dashboards (reports queue,
# venue-claim review). Must match a real signed-in user's email.
PRIVATE_ADMIN_EMAIL=you@example.com

# --- Optional — no-op cleanly when unset ---
RESEND_API_KEY=                # unset: emails are silently skipped, not errored
PUBLIC_SENTRY_DSN=             # unset: no error reporting

# --- Only needed to run `npm run test:integration` ---
# A second, separate Supabase project — integration tests create and delete
# real rows/users here. Never point these at your production project.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
